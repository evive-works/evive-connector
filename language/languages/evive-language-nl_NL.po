#: blocks/switcher/render.php includes/class-settings.php
msgid "Language"
msgstr "Taal"

#: includes/class-rest.php
msgid "This post type cannot be translated."
msgstr "Dit berichttype kan niet worden vertaald."

#: includes/class-rest.php
msgid "Choose a post on another site."
msgstr "Kies een bericht op een andere site."

#: includes/class-rest.php
msgid "The translation must exist and be of the same type."
msgstr "De vertaling moet bestaan en van hetzelfde type zijn."

#: includes/class-rest.php
msgid "(no title)"
msgstr "(geen titel)"

#: includes/class-settings.php
#, php-format
msgid "This site is in %s (Settings → General → Site Language). Leave a field empty to use the default shown."
msgstr "De taal van deze site is %s (Instellingen → Algemeen → Sitetaal). Laat een veld leeg om de getoonde standaardwaarde te gebruiken."

#: includes/class-settings.php
msgid "Language switching"
msgstr "Taalwisseling"

#: includes/class-settings.php
msgid "This site is one of the languages of the network"
msgstr "Deze site is een van de talen van het netwerk"

#: includes/class-settings.php
msgid "Language code"
msgstr "Taalcode"

#: includes/class-settings.php
msgid "Short code shown in the language switcher, e.g. nl."
msgstr "Korte code in de taalwisselaar, bijvoorbeeld nl."

#: includes/class-settings.php
msgid "Label"
msgstr "Label"

#: includes/class-settings.php
msgid "Name of the language in that language, e.g. Nederlands."
msgstr "Naam van de taal in die taal, bijvoorbeeld English."

#: includes/class-settings.php
msgid "hreflang code"
msgstr "hreflang-code"

#: includes/class-settings.php
msgid "Language (and optional region) for search engines, e.g. nl-NL or en."
msgstr "Taal (en eventueel regio) voor zoekmachines, bijvoorbeeld nl-NL of en."

#: includes/class-settings.php
msgid "Languages"
msgstr "Talen"

#: includes/class-settings.php
msgid "Settings saved."
msgstr "Instellingen opgeslagen."

#: includes/class-settings.php
msgid "International fallback (x-default)"
msgstr "Internationale terugval (x-default)"

#: includes/class-settings.php
msgid "— None —"
msgstr "— Geen —"

#: includes/class-settings.php
msgid "Search engines send visitors whose language has no site of its own to this site."
msgstr "Zoekmachines sturen bezoekers voor wier taal geen eigen site bestaat naar deze site."

#: includes/class-settings.php
msgid "Sites"
msgstr "Sites"

#: includes/class-settings.php
msgid "Site"
msgstr "Site"

#: includes/class-settings.php
msgid "Code"
msgstr "Code"

#: includes/class-settings.php
msgid "hreflang"
msgstr "hreflang"

#: includes/class-settings.php
msgid "You are not allowed to change these settings."
msgstr "Je mag deze instellingen niet wijzigen."

